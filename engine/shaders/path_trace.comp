#version 450

layout(local_size_x = 8, local_size_y = 8) in;

struct Triangle {
    vec4 p[3];
    vec4 n[3];
    vec4 albedo_metallic;
    vec4 emission_roughness;
};
struct Node { vec4 minimum; vec4 maximum; uvec4 links; };
struct Light {
    vec3 position; float type;
    vec3 direction; float range;
    vec3 color; float intensity;
    float inner_cone_cos; float outer_cone_cos; float casts_shadow; float shadow_distance;
};
layout(std430, set = 0, binding = 0) readonly buffer Nodes { Node nodes[]; };
layout(std430, set = 0, binding = 1) readonly buffer Triangles { Triangle triangles[]; };
layout(std430, set = 0, binding = 2) readonly buffer Lights { Light lights[]; };
layout(rgba32f, set = 0, binding = 3) uniform image2D accumulation;
layout(std430, set = 0, binding = 4) readonly buffer Emitters { uint emitters[]; };
layout(push_constant) uniform Parameters {
    mat4 inverse_view_projection;
    vec4 background;
    uvec4 dimensions; // width, height, sample, bounces
    uvec4 counts; // nodes, lights, seed, emitters
} parameters;

const float PI = 3.141592653589793;
uint rng;
uint hash_uint(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    return x ^ (x >> 16);
}
float random_float() {
    rng = rng * 1664525u + 1013904223u;
    return float(hash_uint(rng) >> 8) * (1.0 / 16777216.0);
}

bool box_hit(Node node, vec3 origin, vec3 direction, float maximum) {
    float near_t = 0.0;
    float far_t = maximum;
    for(int axis = 0; axis < 3; ++axis) {
        if(abs(direction[axis]) < 1e-12) {
            if(origin[axis] < node.minimum[axis] || origin[axis] > node.maximum[axis])
                return false;
        } else {
            float a = (node.minimum[axis] - origin[axis]) / direction[axis];
            float b = (node.maximum[axis] - origin[axis]) / direction[axis];
            near_t = max(near_t, min(a, b));
            far_t = min(far_t, max(a, b));
            if(near_t > far_t)
                return false;
        }
    }
    return true;
}

bool intersect_scene(vec3 origin, vec3 direction, inout float maximum,
                     out uint triangle_index, out vec3 barycentric, bool shadow) {
    bool found = false;
    uint node_index = 0;
    while(node_index < parameters.counts.x) {
        Node node = nodes[node_index];
        if(!box_hit(node, origin, direction, maximum)) {
            node_index = node.links.w;
            continue;
        }
        ++node_index;
        for(uint i = 0; i < node.links.y; ++i) {
            uint index = node.links.x + i;
            Triangle triangle = triangles[index];
            vec3 e1 = triangle.p[1].xyz - triangle.p[0].xyz;
            vec3 e2 = triangle.p[2].xyz - triangle.p[0].xyz;
            vec3 p = cross(direction, e2);
            float determinant = dot(e1, p);
            if(abs(determinant) < 1e-10 || (triangle.p[0].w == 0.0 && determinant < 0.0))
                continue;
            vec3 delta = origin - triangle.p[0].xyz;
            float u = dot(delta, p) / determinant;
            vec3 q = cross(delta, e1);
            float v = dot(direction, q) / determinant;
            float t = dot(e2, q) / determinant;
            if(u < 0.0 || v < 0.0 || u + v > 1.0 || t <= 1e-5 || t >= maximum)
                continue;
            if(shadow)
                return true;
            maximum = t;
            triangle_index = index;
            barycentric = vec3(1.0 - u - v, u, v);
            found = true;
        }
    }
    return found;
}

vec3 local_direction(vec3 local, vec3 normal) {
    vec3 tangent = normalize(cross(abs(normal.z) < 0.999 ? vec3(0, 0, 1) : vec3(0, 1, 0), normal));
    return tangent * local.x + cross(normal, tangent) * local.y + normal * local.z;
}
float distribution(float nh, float alpha2) {
    float denominator = nh * nh * (alpha2 - 1.0) + 1.0;
    return alpha2 / (PI * denominator * denominator);
}
float masking(float cosine, float alpha2) {
    return 2.0 * cosine / (cosine + sqrt(alpha2 + (1.0 - alpha2) * cosine * cosine));
}
vec3 bsdf(Triangle triangle, vec3 normal, vec3 outgoing, vec3 incoming, out float pdf) {
    float nv = dot(normal, outgoing);
    float nl = dot(normal, incoming);
    pdf = 0.0;
    if(nv <= 0.0 || nl <= 0.0 || dot(outgoing + incoming, outgoing + incoming) < 1e-12)
        return vec3(0);
    vec3 half_vector = normalize(outgoing + incoming);
    float nh = max(dot(normal, half_vector), 0.0);
    float vh = max(dot(outgoing, half_vector), 1e-7);
    float metallic = triangle.albedo_metallic.w;
    vec3 base = triangle.albedo_metallic.xyz;
    float alpha2 = pow(triangle.emission_roughness.w, 4.0);
    float d = distribution(nh, alpha2);
    vec3 f0 = mix(vec3(0.04), base, metallic);
    vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);
    float specular_probability = 0.5 + 0.5 * metallic;
    pdf = mix(nl / PI, d * nh / (4.0 * vh), specular_probability);
    return (1.0 - fresnel) * (1.0 - metallic) * base / PI
        + fresnel * d * masking(nv, alpha2) * masking(nl, alpha2) / (4.0 * nv * nl);
}

vec3 sample_bsdf(Triangle triangle, vec3 normal, vec3 outgoing) {
    float u = random_float();
    float phi = 2.0 * PI * random_float();
    if(random_float() < 0.5 + 0.5 * triangle.albedo_metallic.w) {
        float alpha2 = pow(triangle.emission_roughness.w, 4.0);
        float cosine = sqrt((1.0 - u) / (1.0 + (alpha2 - 1.0) * u));
        float sine = sqrt(max(0.0, 1.0 - cosine * cosine));
        vec3 half_vector = local_direction(vec3(sine * cos(phi), sine * sin(phi), cosine), normal);
        return reflect(-outgoing, half_vector);
    }
    float radius = sqrt(u);
    return local_direction(vec3(radius * cos(phi), radius * sin(phi), sqrt(1.0 - u)), normal);
}

float power_heuristic(float a, float b) {
    float ratio = b / max(a, 1e-20);
    return 1.0 / (1.0 + ratio * ratio);
}
float emitter_pdf(Triangle triangle, vec3 from, vec3 to) {
    vec3 area_normal = cross(triangle.p[1].xyz - triangle.p[0].xyz, triangle.p[2].xyz - triangle.p[0].xyz);
    float twice_area = length(area_normal);
    vec3 delta = to - from;
    float squared_distance = dot(delta, delta);
    float cosine = dot(area_normal / twice_area, -normalize(delta));
    if(triangle.p[0].w != 0.0)
        cosine = abs(cosine);
    if(cosine <= 1e-7 || squared_distance <= 1e-10)
        return 0.0;
    return 2.0 * squared_distance / (float(parameters.counts.w) * twice_area * cosine);
}
vec3 direct_emitter(Triangle triangle, vec3 position, vec3 normal, vec3 geometric,
                    vec3 outgoing, float bias, bool use_mis) {
    if(parameters.counts.w == 0)
        return vec3(0);
    uint selected = min(uint(random_float() * float(parameters.counts.w)), parameters.counts.w - 1);
    Triangle emitter = triangles[emitters[selected]];
    float root = sqrt(random_float());
    float v = random_float();
    vec3 point = emitter.p[0].xyz * (1.0 - root) + emitter.p[1].xyz * (root * (1.0 - v)) + emitter.p[2].xyz * (root * v);
    vec3 delta = point - position;
    float distance = length(delta);
    if(distance <= 2.0 * bias)
        return vec3(0);
    vec3 direction = delta / distance;
    if(dot(normal, direction) <= 0.0 || dot(geometric, direction) <= 0.0)
        return vec3(0);
    float light_pdf = emitter_pdf(emitter, position, point);
    if(light_pdf <= 0.0)
        return vec3(0);
    uint index; vec3 barycentric;
    float maximum = distance - 2.0 * bias;
    if(intersect_scene(position + geometric * bias, direction, maximum, index, barycentric, true))
        return vec3(0);
    float bsdf_pdf;
    vec3 value = bsdf(triangle, normal, outgoing, direction, bsdf_pdf);
    float weight = use_mis ? power_heuristic(light_pdf, bsdf_pdf) : 1.0;
    return value * emitter.emission_roughness.xyz * max(dot(normal, direction), 0.0) * weight / light_pdf;
}

vec3 direct_light(Triangle triangle, vec3 position, vec3 normal, vec3 geometric, vec3 outgoing, float bias) {
    vec3 result = vec3(0);
    for(uint i = 0; i < parameters.counts.y; ++i) {
        Light light = lights[i];
        vec3 direction = -light.direction;
        float distance = 1e30;
        float attenuation = 1.0;
        if(light.type != 0.0) {
            vec3 delta = light.position - position;
            float squared_distance = dot(delta, delta);
            if(squared_distance < 1e-8 || squared_distance >= light.range * light.range)
                continue;
            distance = sqrt(squared_distance);
            direction = delta / distance;
            float falloff = max(1.0 - pow(distance / light.range, 4.0), 0.0);
            attenuation = falloff * falloff / max(squared_distance, 0.01);
            if(light.type == 2.0) {
                float alignment = dot(-direction, light.direction);
                if(light.inner_cone_cos - light.outer_cone_cos > 1e-6)
                    attenuation *= smoothstep(light.outer_cone_cos, light.inner_cone_cos, alignment);
                else if(alignment < light.outer_cone_cos)
                    continue;
            }
        }
        float cosine = dot(normal, direction);
        if(cosine <= 0.0 || dot(geometric, direction) <= 0.0 || attenuation <= 0.0)
            continue;
        uint index; vec3 barycentric;
        float maximum = max(bias, distance - bias);
        if(intersect_scene(position + geometric * bias, direction, maximum, index, barycentric, true))
            continue;
        float pdf;
        result += bsdf(triangle, normal, outgoing, direction, pdf) * cosine * light.color * light.intensity * attenuation;
    }
    return result;
}

vec3 radiance(vec3 origin, vec3 direction, float primary_distance) {
    vec3 result = vec3(0);
    vec3 throughput = vec3(1);
    float previous_pdf = 0.0;
    vec3 previous_position = origin;
    for(uint bounce = 0; bounce < parameters.dimensions.w; ++bounce) {
        float distance = bounce == 0 ? primary_distance : 1e30;
        uint index; vec3 barycentric;
        if(!intersect_scene(origin, direction, distance, index, barycentric, false)) {
            result += throughput * parameters.background.xyz;
            break;
        }
        Triangle triangle = triangles[index];
        vec3 position = origin + direction * distance;
        vec3 geometric = normalize(cross(triangle.p[1].xyz - triangle.p[0].xyz, triangle.p[2].xyz - triangle.p[0].xyz));
        if(dot(geometric, direction) > 0.0)
            geometric = -geometric;
        vec3 normal = triangle.n[0].xyz * barycentric.x + triangle.n[1].xyz * barycentric.y + triangle.n[2].xyz * barycentric.z;
        normal = dot(normal, normal) < 1e-12 ? geometric : normalize(normal);
        if(dot(normal, geometric) < 0.0)
            normal = -normal;
        if(dot(normal, -direction) <= 0.0)
            normal = geometric;
        float emission_weight = 1.0;
        if(bounce > 0 && parameters.counts.w > 0 && any(greaterThan(triangle.emission_roughness.xyz, vec3(0))))
            emission_weight = power_heuristic(previous_pdf, emitter_pdf(triangle, previous_position, position));
        result += throughput * triangle.emission_roughness.xyz * emission_weight;
        if(triangle.emission_roughness.w < 0.0)
            break;
        float bias = 1e-4 * max(1.0, max(abs(position.x), max(abs(position.y), abs(position.z))));
        result += throughput * direct_light(triangle, position, normal, geometric, -direction, bias);
        result += throughput * direct_emitter(triangle, position, normal, geometric, -direction, bias,
            bounce + 1 < parameters.dimensions.w);
        vec3 incoming = sample_bsdf(triangle, normal, -direction);
        if(dot(geometric, incoming) <= 0.0)
            break;
        float pdf;
        vec3 value = bsdf(triangle, normal, -direction, incoming, pdf);
        if(pdf < 1e-12)
            break;
        throughput *= value * max(dot(normal, incoming), 0.0) / pdf;
        previous_pdf = pdf;
        previous_position = position;
        if(bounce >= 2) {
            float survival = clamp(max(throughput.x, max(throughput.y, throughput.z)), 0.05, 0.95);
            if(random_float() >= survival)
                break;
            throughput /= survival;
        }
        origin = position + geometric * bias;
        direction = incoming;
    }
    return result;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(pixel, parameters.dimensions.xy)))
        return;
    uint sample_index = parameters.dimensions.z;
    rng = hash_uint(pixel.x + pixel.y * parameters.dimensions.x) ^ hash_uint(sample_index + parameters.counts.z * 1664525u);
    vec2 ndc = (vec2(pixel) + vec2(random_float(), random_float())) / vec2(parameters.dimensions.xy) * 2.0 - 1.0;
    // 场景使用负高度 viewport；显示纹理的第 0 行对应相机上方。
    ndc.y = -ndc.y;
    vec4 near_point = parameters.inverse_view_projection * vec4(ndc, 0, 1);
    vec4 far_point = parameters.inverse_view_projection * vec4(ndc, 1, 1);
    vec3 origin = near_point.xyz / near_point.w;
    vec3 delta = far_point.xyz / far_point.w - origin;
    vec3 sample_value = radiance(origin, normalize(delta), length(delta));
    if(any(isnan(sample_value)) || any(isinf(sample_value)))
        sample_value = vec3(0);
    vec3 mean = sample_value;
    if(sample_index > 0)
        mean = imageLoad(accumulation, ivec2(pixel)).xyz + (sample_value - imageLoad(accumulation, ivec2(pixel)).xyz) / float(sample_index + 1);
    imageStore(accumulation, ivec2(pixel), vec4(mean, 1));
}

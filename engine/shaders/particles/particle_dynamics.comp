#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x=64) in;
#include "particle_common.glsl"
struct State { vec4 position_age; vec4 velocity; uvec4 metadata; };
struct WorldCollider { mat4 world_to_local; vec4 extent_shape; uvec4 layers; };
layout(std430,set=0,binding=0) readonly buffer Inputs {
    Parameters parameters;
    mat4 view_projection, inverse_view_projection;
    vec4 timing; // runtime time, elapsed since previous snapshot, radius, restitution
    vec4 dynamics; // turbulence acceleration, spatial frequency, friction
    uvec4 history; // previous birth count, collision mode
    vec4 wind, vortex_center, vortex_axis;
    vec4 field_minimum, field_size, field_dimensions;
    uvec4 world;
    WorldCollider colliders[64];
    Spawn births[];
};
layout(std430,set=0,binding=1) readonly buffer Previous {
    uvec4 previous_draw;
    State previous[];
};
layout(std430,set=0,binding=2) writeonly buffer Instances { Particle particles[]; };
layout(std430,set=0,binding=3) buffer Current {
    uint vertex_count, instance_count, first_vertex, first_instance;
    State states[];
};
layout(set=0,binding=4) uniform texture2D scene_depth;
layout(set=0,binding=5) uniform texture2D vector_field;
vec3 sample_vector_field(vec3 position) {
    if(field_size.w == 0) return vec3(0);
    vec3 uvw = (position - field_minimum.xyz) / field_size.xyz;
    if(any(lessThan(uvw, vec3(0))) || any(greaterThan(uvw, vec3(1)))) return vec3(0);
    ivec3 dimensions = ivec3(field_dimensions.xyz);
    vec3 coordinate = uvw * vec3(dimensions - 1);
    ivec3 first = min(ivec3(coordinate), dimensions - 2);
    vec3 blend = coordinate - vec3(first), value = vec3(0);
    for(int z = 0; z < 2; ++z) for(int y = 0; y < 2; ++y) for(int x = 0; x < 2; ++x) {
        ivec3 cell = first + ivec3(x, y, z);
        float weight = (x != 0 ? blend.x : 1 - blend.x)
            * (y != 0 ? blend.y : 1 - blend.y) * (z != 0 ? blend.z : 1 - blend.z);
        value += texelFetch(vector_field, ivec2(cell.x, cell.y + cell.z * dimensions.y), 0).xyz * weight;
    }
    return value * field_minimum.w;
}

bool serial_less(uvec2 first, uvec2 second) {
    return first.y<second.y || (first.y==second.y && first.x<second.x);
}
vec3 surface_position(ivec2 pixel, ivec2 size) {
    float depth=texelFetch(scene_depth,pixel,0).r;
    vec2 ndc=(vec2(pixel)+.5)/vec2(size)*2-1;
    vec4 world=inverse_view_projection*vec4(ndc,depth,1);
    return world.xyz/world.w;
}
struct ColliderHit {
    float fraction;
    vec3 normal;
    vec3 position;
    bool inside;
};
bool intersect_sphere(vec3 origin, vec3 direction, float radius, out ColliderHit hit) {
    float squared_direction = dot(direction, direction);
    float projection = dot(origin, direction);
    float distance = dot(origin, origin) - radius * radius;
    hit.inside = distance < 0;
    hit.fraction = 0;
    if(hit.inside) {
        hit.normal = length(origin) > 1e-6 ? normalize(origin) : vec3(0, 1, 0);
        hit.position = hit.normal * radius;
        return true;
    }
    float discriminant = projection * projection - squared_direction * distance;
    if(squared_direction <= 1e-12 || discriminant < 0) return false;
    hit.fraction = (-projection - sqrt(discriminant)) / squared_direction;
    if(hit.fraction < 0 || hit.fraction > 1) return false;
    hit.position = origin + direction * hit.fraction;
    hit.normal = normalize(hit.position);
    return true;
}
bool intersect_box(vec3 origin, vec3 direction, vec3 extent, out ColliderHit hit) {
    hit.inside = all(lessThan(abs(origin), extent));
    hit.fraction = 0;
    hit.normal = vec3(0);
    if(hit.inside) {
        vec3 margin = extent - abs(origin);
        int axis = 0;
        if(margin.y <= margin.x) axis = 1;
        if(margin.z <= margin[axis]) axis = 2;
        hit.normal[axis] = origin[axis] < 0 ? -1 : 1;
        hit.position = origin;
        hit.position[axis] = hit.normal[axis] * extent[axis];
        return true;
    }
    float leave = 1;
    for(int axis = 0; axis < 3; ++axis) {
        if(abs(direction[axis]) < 1e-8) {
            if(abs(origin[axis]) > extent[axis]) return false;
            continue;
        }
        float first = (-extent[axis] - origin[axis]) / direction[axis];
        float last = (extent[axis] - origin[axis]) / direction[axis];
        float near = min(first, last);
        if(near >= hit.fraction) {
            hit.fraction = near;
            hit.normal = vec3(0);
            hit.normal[axis] = direction[axis] > 0 ? -1 : 1;
        }
        leave = min(leave, max(first, last));
    }
    hit.position = origin + direction * hit.fraction;
    return hit.fraction <= leave && hit.fraction <= 1 && leave >= 0 && length(hit.normal) > .5;
}
bool intersect_capsule(vec3 origin, vec3 direction, float radius, float half_height,
    out ColliderHit hit) {
    vec3 closest = vec3(0, clamp(origin.y, -half_height, half_height), 0);
    vec3 radial = origin - closest;
    if(dot(radial, radial) < radius * radius) {
        hit.inside = true;
        hit.fraction = 0;
        hit.normal = length(radial) > 1e-6 ? normalize(radial) : vec3(1, 0, 0);
        hit.position = closest + hit.normal * radius;
        return true;
    }
    hit.inside = false;
    hit.fraction = 2;
    float a = dot(direction.xz, direction.xz), b = dot(origin.xz, direction.xz);
    float c = dot(origin.xz, origin.xz) - radius * radius;
    float discriminant = b * b - a * c;
    if(a > 1e-12 && discriminant >= 0) {
        float fraction = (-b - sqrt(discriminant)) / a;
        vec3 position = origin + direction * fraction;
        if(fraction >= 0 && fraction <= 1 && abs(position.y) <= half_height) {
            hit.fraction = fraction;
            hit.position = position;
            hit.normal = normalize(vec3(position.x, 0, position.z));
        }
    }
    for(int side = -1; side <= 1; side += 2) {
        vec3 center = vec3(0, float(side) * half_height, 0);
        ColliderHit cap;
        if(intersect_sphere(origin - center, direction, radius, cap)
            && cap.fraction < hit.fraction && cap.position.y * float(side) >= 0) {
            hit = cap;
            hit.position += center;
        }
    }
    return hit.fraction <= 1;
}

#include "particle_mesh_collision.glsl"
void bounce_velocity(vec3 normal, inout vec3 velocity) {
    float speed = dot(velocity, normal);
    if(speed < 0)
        velocity = (velocity - normal * speed) * (1 - dynamics.z) - normal * speed * timing.w;
}
bool collide_world(vec3 old_position, inout vec3 position, inout vec3 velocity) {
    float nearest = 2;
    vec3 hit_normal = vec3(0), hit_position = position;
    for(uint i = 0; i < world.x; ++i) {
        WorldCollider collider = colliders[i];
        if((collider.layers.x & world.y) == 0) continue;
        vec3 origin = (collider.world_to_local * vec4(old_position, 1)).xyz;
        vec3 end = (collider.world_to_local * vec4(position, 1)).xyz;
        mat3 inverse_basis = mat3(collider.world_to_local);
        // 世界球形粒子的半径在盒的各局部轴上分别扩张。
        mat3 inverse_rows = transpose(inverse_basis);
        vec3 radius = vec3(length(inverse_rows[0]), length(inverse_rows[1]),
            length(inverse_rows[2])) * timing.z;
        ColliderHit hit;
        bool collided;
        if(collider.extent_shape.w > 1) {
            float extent = collider.extent_shape.x + max(radius.x, max(radius.y, radius.z));
            collided = intersect_capsule(origin, end - origin, extent, collider.extent_shape.y, hit);
        } else if(collider.extent_shape.w > 0) {
            float extent = collider.extent_shape.x + max(radius.x, max(radius.y, radius.z));
            collided = intersect_sphere(origin, end - origin, extent, hit);
        } else {
            collided = intersect_box(origin, end - origin, collider.extent_shape.xyz + radius, hit);
        }
        if(!collided || hit.fraction >= nearest) continue;
        nearest = hit.fraction;
        hit_normal = normalize(transpose(inverse_basis) * hit.normal);
        hit_position = hit.inside
            ? (inverse(collider.world_to_local) * vec4(hit.position, 1)).xyz
            : mix(old_position, position, hit.fraction);
    }
    if(history.z > 0) {
        ColliderHit mesh_hit;
        bool exhausted;
        bool found = mesh_contact(old_position, position - old_position, nearest, mesh_hit, exhausted);
        // 查询耗尽时终止这一视觉粒子，避免未完成查询却穿过地表。
        if(exhausted) return true;
        if(found) {
            nearest = mesh_hit.fraction;
            hit_normal = mesh_hit.normal;
            hit_position = mesh_hit.position;
        }
    }
    if(nearest > 1) return false;
    if(history.y == 2) return true;
    bounce_velocity(hit_normal, velocity);
    position = hit_position + hit_normal * max(.0001, timing.z * .01);
    return false;
}
bool collide(vec3 old_position, inout vec3 position, inout vec3 velocity) {
    if(history.y==0) return false;
    if(world.z!=0) return collide_world(old_position,position,velocity);
    vec4 projected=view_projection*vec4(position,1);
    if(projected.w<=0) return false;
    vec3 ndc=projected.xyz/projected.w;
    if(any(greaterThanEqual(abs(ndc.xy),vec2(1))) || ndc.z<0 || ndc.z>1) return false;
    ivec2 size=textureSize(scene_depth,0);
    ivec2 pixel=clamp(ivec2((ndc.xy*.5+.5)*vec2(size)),ivec2(0),size-1);
    float depth=texelFetch(scene_depth,pixel,0).r;
    vec4 old_clip=view_projection*vec4(old_position,1);
    if(depth>=1 || ndc.z<depth || old_clip.w<=0 || old_clip.z/old_clip.w>depth+1e-4) return false;
    if(history.y==2) return true;
    vec3 surface=surface_position(pixel,size);
    ivec2 px=ivec2(min(pixel.x+1,size.x-1),pixel.y);
    ivec2 py=ivec2(pixel.x,min(pixel.y+1,size.y-1));
    vec3 normal=cross(surface_position(px,size)-surface,surface_position(py,size)-surface);
    vec3 toward_camera=transpose(mat3(parameters.view))*vec3(0,0,1);
    normal=length(normal)>1e-5 ? normalize(normal) : toward_camera;
    if(dot(normal,toward_camera)<0) normal=-normal;
    bounce_velocity(normal, velocity);
    vec4 contact=inverse_view_projection*vec4(ndc.xy,depth,1);
    position=contact.xyz/contact.w+normal*max(timing.z,.001);
    return false;
}
vec3 particle_acceleration(vec3 position, float time, float phase) {
    vec3 field = position * dynamics.y + vec3(time + phase, time * .7 - phase, time * .9 + phase);
    vec3 turbulence = vec3(sin(field.y) - cos(field.z), sin(field.z) - cos(field.x),
        sin(field.x) - cos(field.y)) * dynamics.x;
    vec3 radial = position - vortex_center.xyz;
    radial -= vortex_axis.xyz * dot(radial, vortex_axis.xyz);
    float radius = length(radial);
    vec3 vortex = vec3(0);
    if(radius > 1e-5)
        vortex = cross(vortex_axis.xyz, radial / radius) * wind.w
            * max(0, 1 - radius / vortex_center.w);
    return parameters.acceleration_lifetime.xyz + wind.xyz + vortex + turbulence + sample_vector_field(position);
}
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index>=parameters.counts.y) return;
    uint low=0, high=parameters.counts.x;
    while(low+1<high) {
        uint middle=(low+high)/2;
        if(births[middle].range.x<=index) low=middle; else high=middle;
    }
    Spawn birth=births[low];
    uint local=index-birth.range.x;
    uvec2 serial=uvec2(birth.range.z+local,birth.range.w);
    if(serial.x<birth.range.z) serial.y++;
    float age=max(0.0,birth.timing.x-float(local)*birth.timing.y);
    vec3 velocity=birth_velocity(birth,local,parameters);
    vec3 position=birth_position(birth,local,parameters);
    float elapsed=age;
    bool alive=true;
    low=0; high=history.x;
    while(low<high) {
        uint middle=(low+high)/2;
        if(serial_less(previous[middle].metadata.xy,serial)) low=middle+1; else high=middle;
    }
    if(low<history.x && all(equal(previous[low].metadata.xy,serial))) {
        position=previous[low].position_age.xyz;
        velocity=previous[low].velocity.xyz;
        elapsed=timing.y;
        alive=previous[low].metadata.z!=0;
    }
    // 有界追赶；首次可见或长时间未渲染时，从当前弹道的最近 .25 秒开始。
    if(elapsed>.25) {
        float skipped=elapsed-.25;
        position+=velocity*skipped+parameters.acceleration_lifetime.xyz*(.5*skipped*skipped);
        velocity+=parameters.acceleration_lifetime.xyz*skipped;
        elapsed=.25;
    }
    uint steps=min(16u,uint(ceil(max(elapsed,0.0)*60)));
    float dt=steps>0 ? elapsed/float(steps) : 0;
    float phase=float(random_hash(serial.x^parameters.counts.w)&65535u)*.001;
    for(uint step=0; step<steps && alive; ++step) {
        float time=timing.x-elapsed+float(step)*dt;
        vec3 acceleration = particle_acceleration(position, time, phase);
        vec3 next=position+velocity*dt+acceleration*(.5*dt*dt);
        velocity+=acceleration*dt;
        if(collide(position,next,velocity)) alive=false;
        position=next;
    }
    alive=alive && age<parameters.acceleration_lifetime.w;
    states[index]=State(vec4(position,age),vec4(velocity,0),uvec4(serial,alive ? 1u : 0u,0));
    if(alive) {
        uint output_index=atomicAdd(instance_count,1);
        particles[output_index]=particle_appearance(position,age,index,parameters);
    }
}

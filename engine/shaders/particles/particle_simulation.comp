#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=64) in;
#include "particle_common.glsl"
layout(std430,set=0,binding=0) readonly buffer Births { Spawn births[]; };
layout(std430,set=0,binding=1) readonly buffer Uniforms { Parameters parameters; };
layout(std430,set=0,binding=2) writeonly buffer Instances { Particle particles[]; };
layout(std430,set=0,binding=3) writeonly buffer Draw {
    uint vertex_count, instance_count, first_vertex, first_instance;
};
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index==0) {
        vertex_count=6; instance_count=parameters.counts.y; first_vertex=0; first_instance=0;
    }
    if(index>=parameters.counts.z) return;
    Particle particle=empty_particle(index);
    if(index<parameters.counts.y) {
        uint low=0, high=parameters.counts.x;
        while(low+1<high) {
            uint middle=(low+high)/2;
            if(births[middle].range.x<=index) low=middle; else high=middle;
        }
        Spawn birth=births[low];
        uint local=index-birth.range.x;
        float age=max(0.0,birth.timing.x-float(local)*birth.timing.y);
        vec3 velocity=birth_velocity(birth,local,parameters);
        vec3 position=birth_position(birth,local,parameters)+velocity*age+parameters.acceleration_lifetime.xyz*(.5*age*age);
        particle=particle_appearance(position,age,index,parameters);
    }
    particles[index]=particle;
}

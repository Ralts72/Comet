#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;
layout(rgba32f, set = 0, binding = 3) uniform writeonly image2D updated_probes;
layout(rgba32f, set = 0, binding = 9) uniform readonly image2D previous_probes;
layout(push_constant) uniform Parameters {
    vec4 origin_distance;
    vec4 spacing_history;
    vec4 grid_dimensions;
    vec4 visibility;
    vec4 background;
    uvec4 dimensions; // first probe, budget, rays, update iteration
    uvec4 counts; // nodes, lights, seed, emitters
    vec4 environment;
} parameters;

// 双面求交用于识别实心几何内的探针；背面不向外发射间接光。
#define RAY_CULL_BACKFACES 0
#include "raytracing/scene.glsl"
#include "lighting/irradiance_basis.glsl"

shared vec3 radiances[256];
shared vec3 directions[256];
shared uint backfaces[256];
shared float probe_active;

vec3 probe_radiance(vec3 origin, vec3 direction, out uint backface) {
    float distance = parameters.origin_distance.w;
    uint index;
    vec3 barycentric;
    backface = 0;
    if(!intersect_scene(origin, direction, distance, index, barycentric, false))
        return environment_size.x == 0 ? vec3(0) : environment_radiance(direction, false);
    Triangle triangle = triangles[index];
    vec3 geometric = normalize(cross(triangle.p[1].xyz - triangle.p[0].xyz,
        triangle.p[2].xyz - triangle.p[0].xyz));
    Surface surface = hit_surface(triangle, barycentric);
    if(dot(geometric, direction) >= 0.0) {
        if(surface.parameters.y == 0.0) {
            backface = 1;
            return vec3(0);
        }
        geometric = -geometric;
    }
    vec3 result = surface.emission_roughness.rgb;
    if(surface.emission_roughness.w < 0.0) return result;
    vec3 point = origin + direction * distance;
    vec3 normal = hit_normal(triangle, surface, barycentric, geometric, -direction);
    float bias = 1e-4 * max(1.0, max(abs(point.x), max(abs(point.y), abs(point.z))));
    // 射线从探针到表面，再求表面对灯光／发光面／环境的响应：一跳间接光。
    result += direct_light(surface, point, normal, geometric, -direction, bias);
    result += direct_emitter(surface, point, normal, geometric, -direction, bias, false);
    result += direct_environment(surface, point, normal, geometric, -direction, bias, false);
    return result;
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    uvec3 dimensions = uvec3(parameters.grid_dimensions.xyz);
    uint count = dimensions.x * dimensions.y * dimensions.z;
    uint probe = (parameters.dimensions.x + gl_WorkGroupID.x) % count;
    uvec3 cell = uvec3(probe % dimensions.x, (probe / dimensions.x) % dimensions.y,
        probe / (dimensions.x * dimensions.y));
    vec3 position = parameters.origin_distance.xyz + vec3(cell) * parameters.spacing_history.xyz;
    uint rays = parameters.dimensions.z;
    rng = hash_uint(probe) ^ hash_uint(parameters.dimensions.w * 1664525u + lane);
    // 每次更新旋转均匀球面序列；避免少量探针的固定方向条纹。
    uint rotation = hash_uint(probe ^ parameters.dimensions.w * 747796405u);
    float vertical = float(rotation >> 8) * (2.0 / 16777216.0) - 1.0;
    float angle = float(hash_uint(rotation) >> 8) * (2.0 * PI / 16777216.0);
    vec3 axis = vec3(sqrt(max(0.0, 1.0 - vertical * vertical)) * cos(angle),
        sqrt(max(0.0, 1.0 - vertical * vertical)) * sin(angle), vertical);
    for(uint ray = lane; ray < rays; ray += 64) {
        float z = 1.0 - 2.0 * (float(ray) + 0.5) / float(rays);
        float radius = sqrt(max(0.0, 1.0 - z * z));
        float phi = 2.3999632297 * float(ray) + angle;
        directions[ray] = local_direction(vec3(radius * cos(phi), radius * sin(phi), z), axis);
        radiances[ray] = probe_radiance(position, directions[ray], backfaces[ray]);
        if(any(isnan(radiances[ray])) || any(isinf(radiances[ray]))) radiances[ray] = vec3(0);
    }
    barrier();
    if(lane == 0) {
        uint inside = 0;
        for(uint ray = 0; ray < rays; ++ray) inside += backfaces[ray];
        probe_active = inside * 4 <= rays ? 1.0 : 0.0;
    }
    barrier();
    float history = imageLoad(previous_probes, ivec2(0, probe)).w >= 0.5
        ? parameters.spacing_history.w : 0.0;
    if(lane < 9) {
        vec3 coefficient = vec3(0);
        for(uint ray = 0; ray < rays; ++ray) {
            float basis[9];
            irradiance_basis(directions[ray], basis);
            coefficient += radiances[ray] * basis[lane];
        }
        // Lambert 卷积并除以 pi，与静态探针保存的 E/pi 契约相同。
        float convolution = lane == 0 ? 1.0 : (lane < 4 ? 2.0 / 3.0 : 0.25);
        coefficient *= 4.0 * PI * convolution / float(rays);
        coefficient = mix(coefficient, imageLoad(previous_probes, ivec2(lane, probe)).rgb, history);
        imageStore(updated_probes, ivec2(lane, probe), vec4(coefficient * probe_active, lane == 0 ? probe_active : 0.0));
    }
    barrier();
    // 每个八面体方向格单独测距；跨帧累积一、二阶矩，供表面采样的可见性权重使用。
    vec2 coordinate = (vec2(lane % 8, lane / 8) + vec2(random_float(), random_float())) / 8.0;
    vec3 direction = irradiance_oct_direction(coordinate);
    float distance = min(parameters.origin_distance.w, parameters.visibility.x);
    uint index;
    vec3 barycentric;
    intersect_scene(position, direction, distance, index, barycentric, false);
    vec2 moments = vec2(distance, distance * distance);
    // 一对方向打包为一个 Vec4，由偶数 lane 写入，避免相邻 lane 的图像写入竞争。
    directions[lane] = vec3(moments, 0);
    barrier();
    if(lane < 32) {
        vec4 value = vec4(directions[lane * 2].xy, directions[lane * 2 + 1].xy);
        value = mix(value, imageLoad(previous_probes, ivec2(9 + lane, probe)), history);
        imageStore(updated_probes, ivec2(9 + lane, probe), value);
    }
}

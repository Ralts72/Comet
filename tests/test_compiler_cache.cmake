cmake_minimum_required(VERSION 3.31)

if(NOT DEFINED COMET_SOURCE_ROOT OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "COMET_SOURCE_ROOT and TEST_ROOT are required")
endif()
if(WIN32)
    message(STATUS "Compiler cache fixture requires a POSIX shell")
    return()
endif()
if(NOT DEFINED GENERATOR)
    set(GENERATOR "Unix Makefiles")
endif()
if(NOT GENERATOR MATCHES "Makefiles|Ninja")
    message(STATUS "Compiler cache launchers require Makefiles or Ninja")
    return()
endif()

file(MAKE_DIRECTORY "${TEST_ROOT}/source")
set(fake_ccache "${TEST_ROOT}/fake-ccache")
file(WRITE "${fake_ccache}" [=[#!/bin/sh
case "$1" in
    --get-config) printf '%s\n' 'locale' ;;
    --show-stats) printf '%s\n' 'fixture statistics' ;;
    *) exit 1 ;;
esac
]=])
file(CHMOD "${fake_ccache}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
file(WRITE "${TEST_ROOT}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.31)
project(CompilerCacheContract NONE)
foreach(language C CXX)
    set(CMAKE_${language}_COMPILER_ID Clang)
    set(CMAKE_${language}_COMPILER_FRONTEND_VARIANT GNU)
    if(CASE STREQUAL "unsupported")
        set(CMAKE_${language}_COMPILER_FRONTEND_VARIANT MSVC)
    endif()
endforeach()
include("${COMET_SOURCE_ROOT}/cmake/compiler_cache.cmake")
get_directory_property(compile_options COMPILE_OPTIONS)
if(CASE STREQUAL "automatic")
    foreach(language C CXX)
        if(NOT "${CMAKE_${language}_COMPILER_LAUNCHER}" MATCHES "CCACHE_SLOPPINESS=locale,pch_defines,time_macros")
            message(FATAL_ERROR "Missing local PCH cache configuration for ${language}")
        endif()
    endforeach()
    if(NOT compile_options MATCHES "fno-pch-timestamp" OR NOT TARGET comet_cache_stats)
        message(FATAL_ERROR "Missing Clang PCH option or statistics target")
    endif()
elseif(CASE STREQUAL "explicit")
    if(NOT CMAKE_CXX_COMPILER_LAUNCHER STREQUAL "user-launcher;--flag")
        message(FATAL_ERROR "Explicit compiler launcher was replaced")
    endif()
    if(compile_options)
        message(FATAL_ERROR "Automatic Clang PCH flags affected an explicit launcher")
    endif()
elseif(CASE STREQUAL "empty")
    if(NOT DEFINED CMAKE_CXX_COMPILER_LAUNCHER OR NOT CMAKE_CXX_COMPILER_LAUNCHER STREQUAL "")
        message(FATAL_ERROR "Explicit empty compiler launcher was replaced")
    endif()
    if(compile_options)
        message(FATAL_ERROR "Automatic Clang PCH flags affected an empty launcher")
    endif()
elseif(CASE STREQUAL "disabled" OR CASE STREQUAL "unavailable" OR CASE STREQUAL "unsupported")
    if(DEFINED CMAKE_CXX_COMPILER_LAUNCHER OR DEFINED CMAKE_C_COMPILER_LAUNCHER
        OR compile_options OR TARGET comet_cache_stats)
        message(FATAL_ERROR "Unavailable or disabled cache changed compiler configuration")
    endif()
endif()
]=])

foreach(case automatic explicit empty disabled unavailable unsupported)
    set(arguments "-DCOMET_CCACHE_EXECUTABLE=${fake_ccache}")
    if(case STREQUAL "explicit")
        list(APPEND arguments "-DCMAKE_CXX_COMPILER_LAUNCHER=user-launcher\;--flag")
    elseif(case STREQUAL "empty")
        list(APPEND arguments "-DCMAKE_CXX_COMPILER_LAUNCHER=")
    elseif(case STREQUAL "disabled")
        list(APPEND arguments "-DCOMET_USE_COMPILER_CACHE=OFF")
    elseif(case STREQUAL "unavailable")
        # An installed cache may disappear between configurations.
        set(arguments "-DCOMET_CCACHE_EXECUTABLE=${TEST_ROOT}/missing-ccache")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -G "${GENERATOR}"
        -S "${TEST_ROOT}/source" -B "${TEST_ROOT}/${case}"
        "-DCOMET_SOURCE_ROOT=${COMET_SOURCE_ROOT}" "-DCASE=${case}" ${arguments}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Compiler cache ${case} configuration failed:\n${output}\n${error}")
    endif()
endforeach()

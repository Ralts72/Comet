body {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    font-family: Comet;
    font-weight: bold;
    font-size: 16dp;
    color: #eef2f8;
    pointer-events: none;
}
#hud {
    position: absolute;
    top: 18dp;
    right: 22dp;
    text-align: right;
}
#fps { margin-right: 16dp; color: #b6c3d7; }
#game-hint, #combat-hint {
    position: absolute;
    left: 22dp;
    bottom: 18dp;
    width: 70%;
    max-width: 650dp;
    font-size: 14dp;
    color: #d1def0;
}
#course-actions {
    position: absolute;
    top: 18dp;
    left: 22dp;
    max-width: 60%;
    font-size: 14dp;
}
#notice { display: block; max-width: 360dp; color: #ffa79c; margin-top: 8dp; }
button {
    display: inline-block;
    box-sizing: border-box;
    min-width: 88dp;
    padding: 10dp 16dp;
    margin: 4dp;
    border: 1dp #42536e;
    border-radius: 7dp;
    background-color: #233049;
    color: #eef2f8;
    text-align: center;
    vertical-align: middle;
    pointer-events: auto;
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}
button:hover { background-color: #334865; }
button:focus { border-color: #7dc4ff; background-color: #354f71; }
button:active { background-color: #476e99; }
button[disabled] {
    color: #7c8ca4;
    background-color: #202b3c;
    focus: none;
    pointer-events: none;
    tab-index: none;
}
.primary { background-color: #2c698d; border-color: #52a8cc; }
.icon {
    width: 24dp;
    height: 24dp;
    margin-right: 4dp;
    vertical-align: middle;
    pointer-events: none;
}
.icon.trailing { margin-right: 0; margin-left: 4dp; }
button[disabled] .icon { opacity: 0.45; }
#menu {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #101927cc;
    pointer-events: auto;
}
#panel {
    display: block;
    box-sizing: border-box;
    width: 82%;
    max-width: 880dp;
    max-height: 82%;
    margin: 5% auto;
    padding: 24dp;
    border: 1dp #40526c;
    background-color: #182538;
    overflow-x: hidden;
    overflow-y: auto;
}
#panel scrollbarvertical { width: 12dp; background-color: #101c2d; }
#panel scrollbarvertical slidertrack { width: 12dp; }
#panel scrollbarvertical sliderbar {
    width: 10dp;
    min-height: 24dp;
    margin-left: 1dp;
    border-radius: 4dp;
    background-color: #526985;
}
#panel scrollbarvertical sliderbar:hover { background-color: #7495b9; }
#panel scrollbarvertical sliderbar:active { background-color: #8dc8e6; }
#panel scrollbarvertical sliderarrowdec, #panel scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}
.eyebrow { display: block; color: #8dc8e6; font-size: 12dp; letter-spacing: 1dp; }
h1 { display: block; margin: 8dp 0 12dp; font-size: 28dp; }
p { display: block; margin: 8dp 0; }
.muted, .hint { color: #acbbcd; }
.hint { font-size: 12dp; margin-top: 14dp; }
#action-selector { display: block; margin: 18dp 0 12dp; text-align: center; }
#action-name { display: inline-block; min-width: 160dp; font-size: 20dp; vertical-align: middle; }
#bindings { display: block; }
.binding { display: block; margin: 8dp 0; padding: 12dp; border: 1dp #344760; background-color: #1e2e44; }
.binding-name { display: block; margin-bottom: 8dp; color: #d6e9f5; }
.binding-note { display: block; color: #a6b5c8; font-size: 12dp; }
#status { color: #9ad6bd; }
#error { color: #ffa79c; }
#footer { display: block; margin-top: 14dp; text-align: right; }

#display, #quality, #audio { display: block; margin-bottom: 16dp; padding-bottom: 12dp; border-bottom: 1dp #40526c; }
#display-error, #quality-error, #audio-error { color: #ffa79c; }
.display-dimensions { display: block; }
.display-dimensions label { display: inline-block; vertical-align: middle; }
.display-dimensions input {
    display: inline-block;
    box-sizing: border-box;
    width: 104dp;
    padding: 8dp;
    margin: 4dp 12dp 4dp 4dp;
    border: 1dp #42536e;
    background-color: #101c2d;
    color: #eef2f8;
    vertical-align: middle;
    pointer-events: auto;
    tab-index: auto;
}
.display-dimensions input:focus { border-color: #7dc4ff; }
.display-dimensions input[disabled] { color: #7c8ca4; tab-index: none; }

#audio label, #display label[for="display-hdr-headroom"], #display label[for="display-hdr-white"] { display: block; margin-top: 8dp; }
.calibration, #audio input {
    display: block;
    width: 90%;
    max-width: 520dp;
    height: 28dp;
    margin: 8dp 0;
    pointer-events: auto;
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
}
.calibration slidertrack, #audio input slidertrack { height: 8dp; margin-top: 10dp; background-color: #101c2d; }
.calibration sliderbar, #audio input sliderbar { width: 18dp; height: 28dp; border-radius: 4dp; background-color: #7495b9; }
.calibration:focus sliderbar, #audio input:focus sliderbar, .calibration sliderbar:active, #audio input sliderbar:active { background-color: #8dc8e6; }
.calibration sliderarrowdec, #audio input sliderarrowdec, .calibration sliderarrowinc, #audio input sliderarrowinc { width: 0; height: 0; }
.calibration[disabled], #audio input[disabled] { opacity: 0.5; pointer-events: none; tab-index: none; }

#display-confirmation { display: block; margin-top: 12dp; padding: 12dp; border: 1dp #52a8cc; background-color: #203b50; }

#tour-guide {
    position: absolute; left: 18dp; top: 16dp; width: 54%; max-width: 540dp;
    box-sizing: border-box; padding: 14dp 18dp; border-left: 3dp #75b9c9;
    background-color: #101c2de6; font-size: 14dp;
}
#tour-guide h1 { font-size: 24dp; margin: 4dp 0 8dp; }
.tour-progress { color: #a3bacb; margin-top: 6dp; font-size: 12dp; }
.tour-task { margin-top: 10dp; color: #e0cc98; }
.tour-complete { margin-top: 10dp; color: #9ad6bd; }
#tour-guide button, #tour-actions button { min-width: 70dp; padding: 7dp 10dp; font-size: 13dp; }
#tour-actions { position: absolute; left: 18dp; bottom: 14dp; width: 85%; }
.tour-controls { font-size: 12dp; color: #c0cee1; margin: 4dp; }
#tour-menu {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background-color: #0b1422e8; pointer-events: auto;
}
#tour-panel {
    box-sizing: border-box; width: 85%; max-width: 850dp; height: 88%;
    margin: 3% auto; padding: 22dp; background-color: #182538; border: 1dp #40526c;
    overflow-x: hidden; overflow-y: auto;
}
#tour-chapters { display: block; height: 48%; overflow-x: hidden; overflow-y: auto; }
.chapter-section { margin: 14dp 4dp 6dp; color: #9dcedc; font-size: 14dp; }
.chapter { display: block; width: 96%; text-align: left; margin: 5dp 0; padding: 9dp 12dp; }
.chapter span { float: right; color: #a9bdd0; font-size: 12dp; }
.chapter.selected { background-color: #31546a; border-color: #84b9ca; }
.tour-footer { margin-top: 18dp; padding-top: 8dp; border-top: 1dp #40526c; }
#combat-hint { bottom: 120dp; }

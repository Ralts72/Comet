<rml>
<head>
    <title>Comet Runtime</title>
    <link type="text/rcss" href="runtime.rcss" />
</head>
<body data-model="ui">
    <div id="hud">
        <span id="fps">{{ fps_text }}</span>
        <button id="settings" data-event-click="command('open')" data-attrif-disabled="!menu_available">设置 / F1</button>
        <div id="notice">{{ error_text }}</div>
    </div>
    <div id="menu" style="display: none;">
        <div id="panel">
            <div class="eyebrow">COMET · 游戏设置</div>
            <h1>游戏设置</h1>
            <div id="display" data-if="display_available">
                <p>显示设置</p>
                <div class="display-dimensions">
                    <label for="display-width">宽</label>
                    <input id="display-width" type="text" maxlength="10" size="6" data-attr-value="display_width" data-event-change="command('display_width', ev.value)" data-attrif-disabled="waiting" />
                    <label for="display-height">高</label>
                    <input id="display-height" type="text" maxlength="10" size="6" data-attr-value="display_height" data-event-change="command('display_height', ev.value)" data-attrif-disabled="waiting" />
                </div>
                <button id="display-size" data-event-click="command('display_size')" data-attrif-disabled="waiting">预设尺寸：{{ display_size }}</button>
                <button id="display-mode" data-event-click="command('display_mode')" data-attrif-disabled="waiting || display_preview">{{ display_mode }}</button>
                <button id="display-vsync" data-event-click="command('display_vsync')" data-attrif-disabled="waiting || display_preview">VSync 请求：{{ display_vsync }}</button>
                <p class="hint">{{ display_status }}</p>
                <p id="display-active-vsync" class="hint">{{ display_active_vsync }}</p>
                <button id="display-restore" data-event-click="command('display_restore')" data-attrif-disabled="waiting">显示默认值</button>
                <button id="display-apply" data-event-click="command('display_apply')" data-attrif-disabled="waiting">应用显示设置</button>
            </div>
            <p id="display-error">{{ display_error }}</p>
            <p class="muted">选择动作，录入新的按键或手柄按钮。取消不会保存草稿。</p>
            <div id="action-selector">
                <button id="previous" data-event-click="command('previous')" data-attrif-disabled="waiting || !has_actions">上一个</button>
                <span id="action-name">{{ action_name }}</span>
                <button id="next" data-event-click="command('next')" data-attrif-disabled="waiting || !has_actions">下一个</button>
            </div>
            <div id="bindings"></div>
            <p id="status">{{ status_text }}</p>
            <p id="error">{{ error_text }}</p>
            <div id="footer">
                <button id="restore" data-event-click="command('restore')" data-attrif-disabled="waiting">恢复全部默认</button>
                <button id="cancel" data-event-click="command('cancel')" data-attrif-disabled="waiting">取消</button>
                <button id="apply" class="primary" data-event-click="command('apply')" data-attrif-disabled="waiting || !has_actions">应用并返回</button>
            </div>
            <p class="hint">键鼠：Tab / 方向键选择，Enter 确认，Esc 返回 · 手柄：方向键选择，A 确认，B 返回</p>
        </div>
    </div>
</body>
</rml>
